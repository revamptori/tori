# ==============================================================================
# Tori Portfolio Environment Configuration
# ==============================================================================

# GitHub Authentication (REQUIRED for live contribution graph)
# Create a fine-grained Personal Access Token at https://github.com/settings/tokens
# Scope required: Public Repositories (read-only) / User (read:user)
GITHUB_TOKEN=ghp_your_fine_grained_github_token_here
GITHUB_USERNAME=revamptori

# Flap Execution Engine
# Options: "rust" (default in production), "python" (httptools+uvloop fallback), "auto"
FLAP_ENGINE=rust

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Cache Durations
CACHE_TTL_SECONDS=300
REFRESH_COOLDOWN_SECONDS=15

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
