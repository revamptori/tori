[Unit]
Description=Tori Portfolio — Flap Web Server (Rust Core / Tokio)
After=network.target

[Service]
Type=simple
User=user
Group=user
WorkingDirectory=/home/user/tori
Environment="FLAP_ENGINE=rust"
Environment="HOST=0.0.0.0"
Environment="PORT=8000"
Environment="PYTHONPATH=/home/user/tori"
EnvironmentFile=-/home/user/tori/.env
ExecStart=/usr/bin/python3 -m backend.app
Restart=always
RestartSec=5s

# Security Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

# Graceful shutdown with SIGTERM (handled by flap / Tokio)
KillSignal=SIGTERM
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
